# Horizon Environment Configuration
# Copy this file to .env and fill in your values

# App Settings
ENV=development
PORT=8000
HOST=0.0.0.0

# Supabase Cloud Configuration (from database.new -> Settings -> API)
# Project URL: e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Project Anon Key (public API key)
SUPABASE_ANON_KEY=
# Service Role Key (optional, for elevated backend operations)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: PostgreSQL direct connection string (from Database -> Connection string)
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
